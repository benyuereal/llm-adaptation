+    def take_draft_token_ids(self) -> DraftTokenIds | None:
+        # Backported: engine post_step calls this (when not async scheduling)
+        # to feed the scheduler's spec_token_ids for the next step. The
+        # standalone runner tracks proposed drafts in req_states.draft_tokens
+        # (GPU, [max_num_reqs, num_speculative_steps]); copy the rows for the
+        # last batch to CPU and pair them with the req_ids.
+        if (
+            not self.do_spec_decode
+            or self._last_draft_req_ids is None
+            or self._last_draft_idx_mapping is None
+        ):
+            return None
+        req_ids = self._last_draft_req_ids
+        idx_mapping = self._last_draft_idx_mapping
+        # Only the first len(req_ids) rows are valid.
+        num_reqs = len(req_ids)
+        idx = idx_mapping[:num_reqs]
+        # Synchronize to ensure the propose() write is visible before the copy.
+        torch.cuda.current_stream().synchronize()
+        draft_tokens_cpu = self.req_states.draft_tokens[idx].to(
+            "cpu", non_blocking=False
+        )
+        draft_token_ids = draft_tokens_cpu.tolist()
+        return DraftTokenIds(req_ids=req_ids, draft_token_ids=draft_token_ids)
