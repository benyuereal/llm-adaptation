+def _ct_dequantize_hip(
+    qweight: torch.Tensor,
+    scales: torch.Tensor,
+    zeros,
+    num_bits: int,
+    pack_factor: int,
+    group_size: int,
+    K: int,
+    N: int,
+) -> torch.Tensor:
+    """Dequantize compressed-tensors pack_quantized format on HIP/DCU.
+
+    Layout:
+        qweight: [N, K // pack_factor] int32, sequential bit packing
+        scales:  [N, K // group_size] bf16/fp16
+        zeros:   [N // pack_factor, K // group_size] int32, packed same as qweight
+                 OR None (symmetric quantization)
+
+    Returns: [N, K] dequantized weight in scales.dtype
+    """
+    mask = (1 << num_bits) - 1
+    shifts = torch.arange(0, 32, num_bits, device=qweight.device, dtype=torch.int32)
+
+    unpacked = (qweight.unsqueeze(-1) >> shifts).to(torch.int32) & mask
+    unpacked = unpacked.reshape(N, K)
+
+    if zeros is not None:
+        zp_unpacked = (zeros.unsqueeze(-1) >> shifts).to(torch.int32) & mask
+        # zeros: [N//pack_factor, K_groups] -> after unpack: [N//pack_factor, K_groups, pack_factor]
+        # Need to merge nibble dim with N dim: permute to [N//pack_factor, pack_factor, K_groups] then reshape
+        num_groups = scales.shape[1]
+        zp_unpacked = zp_unpacked.permute(0, 2, 1).contiguous().reshape(-1, num_groups)
+        zp_unpacked = zp_unpacked[:N, :]
+    else:
+        zp_unpacked = torch.zeros(
+            N, K // group_size, device=qweight.device, dtype=torch.int32
+        )
+
+    zp_expanded = zp_unpacked.repeat_interleave(group_size, dim=1)[:, :K]
+    scales_expanded = scales.repeat_interleave(group_size, dim=1)[:, :K]
+
+    result = (unpacked.to(scales.dtype) - zp_expanded.to(scales.dtype)) * scales_expanded
+    return result
 
 
