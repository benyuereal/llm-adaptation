+    def set_eagle3_layers_to_capture(self, layer_ids: Optional[List[int]] = None):
+        """EAGLE3 target-side hook (patched in for VL class).
+
+        M3 text-only class (MiniMaxM3SparseForCausalLM) has this, but the VL
+        class (loaded by quantized checkpoints) did not. Also wires the per-layer
+        ``_is_layer_to_capture`` flag that MiniMaxM3Model.forward reads but no
+        upstream code was setting (unlike qwen3_moe which setattrs it here).
+        """
+        if not self.pp_group.is_last_rank:
+            return
+
+        self.capture_aux_hidden_states = True
