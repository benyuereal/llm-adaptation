+    def _process_weights_hip(self, layer: torch.nn.Module) -> None:
+        """HIP/DCU: dequant INT4 to BF16 at load time, store as plain weight."""
+        w_q = getattr(layer, "weight_packed")
+        w_s = getattr(layer, "weight_scale")
+        w_zp = getattr(layer, "weight_zero_point", None)
+
+        pack_factor = self.pack_factor
+        num_bits = 32 // pack_factor
+        group_size = self.group_size
+        N, K_packed = w_q.shape
+        K = K_packed * pack_factor
+
+        # Dequant once and store as BF16
+        dequantized = _ct_dequantize_hip(
+            w_q.data, w_s.data, w_zp.data if w_zp is not None else None,
+            num_bits, pack_factor, group_size, K, N
+        )
+
+        # Replace quantized params with single BF16 weight
+        layer.weight_dequantized = torch.nn.Parameter(
+            dequantized.to(w_s.dtype).contiguous(), requires_grad=False
+        )
+        # Remove quantized params to free memory
+        del layer.weight_packed
+        del layer.weight_scale
+        if hasattr(layer, 'weight_zero_point'):
+            del layer.weight_zero_point
